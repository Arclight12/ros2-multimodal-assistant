<?xml version="1.0"?>
<robot name="arm_4dof">

  <material name="grey">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <material name="orange">
    <color rgba="0.9 0.45 0.1 1.0"/>
  </material>
  <material name="dark">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <!-- ================= BASE ================= -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry><cylinder radius="0.060" length="0.030"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry><cylinder radius="0.060" length="0.030"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <mass value="0.60"/>
      <inertia ixx="5.850e-04" ixy="0" ixz="0" iyy="5.850e-04" iyz="0" izz="1.080e-03"/>
    </inertial>
  </link>

  <!-- ================= JOINT 1: base yaw ================= -->
  <joint name="joint1_base_yaw" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.030" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="15" velocity="2.0"/>
  </joint>

  <!-- ================= LINK 1: shoulder housing ================= -->
  <link name="link1">
    <visual>
      <origin xyz="0 0 0.030" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.060"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.030" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.060"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.030" rpy="0 0 0"/>
      <mass value="0.30"/>
      <inertia ixx="1.81875e-04" ixy="0" ixz="0" iyy="1.81875e-04" iyz="0" izz="1.8375e-04"/>
    </inertial>
  </link>

  <!-- ================= JOINT 2: shoulder pitch ================= -->
  <joint name="joint2_shoulder_pitch" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.060" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="15" velocity="1.5"/>
  </joint>

  <!-- ================= LINK 2: upper arm ================= -->
  <link name="link2">
    <visual>
      <origin xyz="0 0 0.090" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.180"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.090" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.180"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.090" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="7.140625e-04" ixy="0" ixz="0" iyy="7.140625e-04" iyz="0" izz="7.8125e-05"/>
    </inertial>
  </link>

  <!-- ================= JOINT 3: elbow pitch ================= -->
  <joint name="joint3_elbow_pitch" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0.180" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.618" effort="10" velocity="1.5"/>
  </joint>

  <!-- ================= LINK 3: forearm ================= -->
  <link name="link3">
    <visual>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <geometry><cylinder radius="0.020" length="0.150"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <geometry><cylinder radius="0.020" length="0.150"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <mass value="0.20"/>
      <inertia ixx="3.950e-04" ixy="0" ixz="0" iyy="3.950e-04" iyz="0" izz="4.000e-05"/>
    </inertial>
  </link>

  <!-- ================= JOINT 4: wrist pitch ================= -->
  <joint name="joint4_wrist_pitch" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0 0.150" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="5" velocity="2.0"/>
  </joint>

  <!-- ================= LINK 4: wrist / gripper mount ================= -->
  <link name="link4">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><cylinder radius="0.018" length="0.050"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><cylinder radius="0.018" length="0.050"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="2.893333e-05" ixy="0" ixz="0" iyy="2.893333e-05" iyz="0" izz="1.620e-05"/>
    </inertial>
  </link>

  <!-- ================= FIXED JOINT: end effector tip ================= -->
  <joint name="joint5_ee_fixed" type="fixed">
    <parent link="link4"/>
    <child link="end_effector"/>
    <origin xyz="0 0 0.050" rpy="0 0 0"/>
  </joint>

  <!-- ================= LINK 5: end effector tip (gripper stub) ================= -->
  <link name="end_effector">
    <visual>
      <origin xyz="0 0 0.010" rpy="0 0 0"/>
      <geometry><box size="0.020 0.020 0.020"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.010" rpy="0 0 0"/>
      <geometry><box size="0.020 0.020 0.020"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.010" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="3.333333e-06" ixy="0" ixz="0" iyy="3.333333e-06" iyz="0" izz="3.333333e-06"/>
    </inertial>
  </link>

</robot>
