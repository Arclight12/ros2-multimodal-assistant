# --- Model data (weights, Vosk model dirs, graphs) ---
# Everything placed under models/ is treated as runtime-fetched data and is
# NOT committed (Vosk model folders, .pt/.pth/.onnx/.tflite weights, etc.).
# A placeholder keeps the directory itself trackable.
models/*
!models/.gitkeep

# Model weight files anywhere in the repo.
*.pt
*.pth
*.onnx
*.tflite
*.pb
*.zip

