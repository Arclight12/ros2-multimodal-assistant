<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="assistant_arm">

  <!-- ========================= -->
  <!-- Robot dimensions          -->
  <!-- ========================= -->

  <xacro:property name="base_radius" value="0.055"/>
  <xacro:property name="base_height" value="0.035"/>

  <xacro:property name="link1_length" value="0.11"/>
  <xacro:property name="link2_length" value="0.10"/>
  <xacro:property name="link3_length" value="0.08"/>
  <xacro:property name="link4_length" value="0.06"/>

  <xacro:property name="link_radius" value="0.018"/>

  <!-- ========================= -->
  <!-- Materials                 -->
  <!-- ========================= -->

  <material name="arm_blue">
    <color rgba="0.15 0.35 0.75 1.0"/>
  </material>

  <material name="arm_gray">
    <color rgba="0.45 0.45 0.45 1.0"/>
  </material>

  <material name="gripper">
    <color rgba="0.75 0.75 0.75 1.0"/>
  </material>


  <!-- ========================= -->
  <!-- Base                      -->
  <!-- ========================= -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${base_radius}"
                   length="${base_height}"/>
      </geometry>
      <material name="arm_gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${base_radius}"
                   length="${base_height}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 ${base_height/2}"/>
      <mass value="0.30"/>
      <inertia
        ixx="0.00035"
        ixy="0"
        ixz="0"
        iyy="0.00035"
        iyz="0"
        izz="0.00045"/>
    </inertial>

  </link>


  <!-- ========================= -->
  <!-- Joint 1: Base Rotation    -->
  <!-- ========================= -->

  <joint name="base_joint"
         type="revolute">

    <parent link="base_link"/>
    <child link="link1"/>

    <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <limit
      lower="-3.14159"
      upper="3.14159"
      effort="10"
      velocity="2.0"/>

  </joint>


  <!-- ========================= -->
  <!-- Link 1                    -->
  <!-- ========================= -->

  <link name="link1">

    <visual>
      <origin xyz="${link1_length/2} 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder
          radius="${link_radius}"
          length="${link1_length}"/>
      </geometry>
      <material name="arm_blue"/>
    </visual>

    <collision>
      <origin xyz="${link1_length/2} 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder
          radius="${link_radius}"
          length="${link1_length}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="${link1_length/2} 0 0"/>
      <mass value="0.15"/>
      <inertia
        ixx="0.00003"
        ixy="0"
        ixz="0"
        iyy="0.00040"
        iyz="0"
        izz="0.00040"/>
    </inertial>

  </link>


  <!-- ========================= -->
  <!-- Joint 2: Shoulder Pitch   -->
  <!-- ========================= -->

  <joint name="shoulder_joint"
         type="revolute">

    <parent link="link1"/>
    <child link="link2"/>

    <origin xyz="${link1_length} 0 0"
            rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <limit
      lower="-1.57"
      upper="1.57"
      effort="10"
      velocity="2.0"/>

  </joint>


  <!-- ========================= -->
  <!-- Link 2                    -->
  <!-- ========================= -->

  <link name="link2">

    <visual>
      <origin xyz="${link2_length/2} 0 0"
              rpy="0 1.5708 0"/>
      <geometry>
        <cylinder
          radius="${link_radius}"
          length="${link2_length}"/>
      </geometry>
      <material name="arm_blue"/>
    </visual>

    <collision>
      <origin xyz="${link2_length/2} 0 0"
              rpy="0 1.5708 0"/>
      <geometry>
        <cylinder
          radius="${link_radius}"
          length="${link2_length}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="${link2_length/2} 0 0"/>
      <mass value="0.12"/>
      <inertia
        ixx="0.00002"
        ixy="0"
        ixz="0"
        iyy="0.00025"
        iyz="0"
        izz="0.00025"/>
    </inertial>

  </link>


  <!-- ========================= -->
  <!-- Joint 3: Elbow Pitch      -->
  <!-- ========================= -->

  <joint name="elbow_joint"
         type="revolute">

    <parent link="link2"/>
    <child link="link3"/>

    <origin xyz="${link2_length} 0 0"
            rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <limit
      lower="-1.57"
      upper="1.57"
      effort="8"
      velocity="2.0"/>

  </joint>


  <!-- ========================= -->
  <!-- Link 3                    -->
  <!-- ========================= -->

  <link name="link3">

    <visual>
      <origin xyz="${link3_length/2} 0 0"
              rpy="0 1.5708 0"/>
      <geometry>
        <cylinder
          radius="${link_radius}"
          length="${link3_length}"/>
      </geometry>
      <material name="arm_blue"/>
    </visual>

    <collision>
      <origin xyz="${link3_length/2} 0 0"
              rpy="0 1.5708 0"/>
      <geometry>
        <cylinder
          radius="${link_radius}"
          length="${link3_length}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="${link3_length/2} 0 0"/>
      <mass value="0.10"/>
      <inertia
        ixx="0.000015"
        ixy="0"
        ixz="0"
        iyy="0.00015"
        iyz="0"
        izz="0.00015"/>
    </inertial>

  </link>


  <!-- ========================= -->
  <!-- Joint 4: Wrist Pitch      -->
  <!-- ========================= -->

  <joint name="wrist_joint"
         type="revolute">

    <parent link="link3"/>
    <child link="link4"/>

    <origin xyz="${link3_length} 0 0"
            rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <limit
      lower="-1.57"
      upper="1.57"
      effort="5"
      velocity="2.0"/>

  </joint>


  <!-- ========================= -->
  <!-- Link 4                    -->
  <!-- ========================= -->

  <link name="link4">

    <visual>
      <origin xyz="${link4_length/2} 0 0"
              rpy="0 1.5708 0"/>
      <geometry>
        <cylinder
          radius="0.015"
          length="${link4_length}"/>
      </geometry>
      <material name="arm_blue"/>
    </visual>

    <collision>
      <origin xyz="${link4_length/2} 0 0"
              rpy="0 1.5708 0"/>
      <geometry>
        <cylinder
          radius="0.015"
          length="${link4_length}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="${link4_length/2} 0 0"/>
      <mass value="0.06"/>
      <inertia
        ixx="0.00001"
        ixy="0"
        ixz="0"
        iyy="0.00006"
        iyz="0"
        izz="0.00006"/>
    </inertial>

  </link>


  <!-- ========================= -->
  <!-- Fixed End Effector        -->
  <!-- ========================= -->

  <joint name="gripper_mount_joint"
         type="fixed">

    <parent link="link4"/>
    <child link="gripper_link"/>

    <origin xyz="${link4_length} 0 0"
            rpy="0 0 0"/>

  </joint>


  <link name="gripper_link">

    <visual>
      <origin xyz="0.025 0 0"/>
      <geometry>
        <box size="0.05 0.035 0.025"/>
      </geometry>
      <material name="gripper"/>
    </visual>

    <collision>
      <origin xyz="0.025 0 0"/>
      <geometry>
        <box size="0.05 0.035 0.025"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.025 0 0"/>
      <mass value="0.05"/>
      <inertia
        ixx="0.00001"
        ixy="0"
        ixz="0"
        iyy="0.00002"
        iyz="0"
        izz="0.00002"/>
    </inertial>

  </link>

</robot>
