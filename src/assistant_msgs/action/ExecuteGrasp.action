# Goal: object identifier and optional latest target pose.
string object_id
geometry_msgs/Pose target_pose
bool has_target_pose
---
# Result: outcome of the grasp execution.

# True if the grasp was executed successfully.
bool success

# Human-readable message describing the outcome or failure reason.
string message
---
# Feedback: state of the ongoing grasp.

# Current stage of the grasp sequence.
string current_state
