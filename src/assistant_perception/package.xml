<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>assistant_perception</name>
  <version>0.1.0</version>
  <description>Perception package: camera abstraction, ArUco and YOLO integration points, workspace scanning and object map generation.</description>
  <maintainer email="team@example.com">Multimodal Assistant Team</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>assistant_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
